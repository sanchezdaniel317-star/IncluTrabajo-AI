# Bloque de IncluTrabajo IA para AGREGAR al final de /etc/caddy/Caddyfile (no reemplaza el de Frutii).
# Antes de agregarlo, el subdominio de DuckDNS debe apuntar a la IP de la instancia: si no resuelve,
# Caddy no obtiene el certificado y el fallo arrastra el arranque entero (también el de Frutii).

inclutrabajo.duckdns.org {
	reverse_proxy 127.0.0.1:3000 {
		# Se SOBRESCRIBE la IP del cliente: así el freno de intentos de login no se puede saltar
		# mandando una cabecera X-Forwarded-For falsa (mismo criterio que Frutii).
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# React Router hidrata con scripts en línea; por eso 'unsafe-inline' en script-src.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		-Server
	}

	encode zstd gzip

	@estaticos path /assets/*
	header @estaticos Cache-Control "public, max-age=31536000, immutable"

	log {
		output file /var/log/caddy/inclutrabajo.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
