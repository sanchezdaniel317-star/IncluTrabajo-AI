# Copia este archivo como .env solo para pruebas locales con PostgreSQL.
# Sin DATABASE_URL la app usa PGlite (PostgreSQL embebido) en .data/pglite y siembra la demo sola.

# PostgreSQL. Contraseña solo alfanumérica (es una URL).
# DATABASE_URL=postgres://inclutrabajo:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/inclutrabajo

# Firma de la cookie de sesión: mínimo 32 caracteres aleatorios. Obligatoria en producción.
# Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Puerto y dirección donde escucha la app (detrás de Caddy).
PORT=3000
HOST=127.0.0.1

# Pon 0 solo si pruebas en local por http (sin TLS).
COOKIE_SECURE=1
